// REAL Google sign-in + REAL YouTube subscribe/like sync.
// Requires GOOGLE_OAUTH_CLIENT_ID (set above) AND this site running on a real
// https:// address added to that Client ID's "Authorized JavaScript origins"
// in Google Cloud Console. Will not work from a local file — that's a Google
// security rule, not something this code can bypass.
// ============================================================
let googleAccessToken = null;
function hasOAuthClientId(){ return GOOGLE_OAUTH_CLIENT_ID && GOOGLE_OAUTH_CLIENT_ID !== "PASTE_YOUR_OAUTH_CLIENT_ID_HERE"; }

function signInWithGoogle(){
  if(!hasOAuthClientId()){
    document.getElementById('signinNote').innerHTML = "Real sign-in needs a Google OAuth Client ID pasted into the code, plus this site hosted on a real https:// address (not a local file). Neither is set up yet.";
    return;
  }
  if(typeof google === 'undefined' || !google.accounts){
    document.getElementById('signinNote').textContent = "Google's sign-in library hasn't loaded (check your internet connection) — try again in a moment.";
    return;
  }
  const tokenClient = google.accounts.oauth2.initTokenClient({
    client_id: GOOGLE_OAUTH_CLIENT_ID,
    scope: 'https://www.googleapis.com/auth/youtube.force-ssl',
    callback: (resp)=>{
      if(resp.access_token){
        googleAccessToken = resp.access_token;
        document.getElementById('signinNote').textContent = "Signed in — likes and subscribes will now sync to your real YouTube account.";
      }
    }
  });
  tokenClient.requestAccessToken();
}

async function realSubscribe(channelId){
  if(!googleAccessToken) return; // not signed in — local-only, already handled by caller
  try{
    await fetch('https://www.googleapis.com/youtube/v3/subscriptions?part=snippet', {
      method:'POST',
      headers:{ 'Authorization':'Bearer '+googleAccessToken, 'Content-Type':'application/json' },
      body: JSON.stringify({ snippet:{ resourceId:{ kind:'youtube#channel', channelId } } })
    });
  }catch(e){ console.warn('Real subscribe failed:', e); }
}
async function realLike(videoId, removeLike=false){
  if(!googleAccessToken) return;
  try{
    const rating = removeLike ? 'none' : 'like';
    await fetch(`https://www.googleapis.com/youtube/v3/videos/rate?id=${videoId}&rating=${rating}`, {
      method:'POST',
      headers:{ 'Authorization':'Bearer '+googleAccessToken }
    });
  }catch(e){ console.warn('Real like failed:', e); }
}
async function realComment(videoId, text){
  if(!googleAccessToken) return false;
  try{
    const res = await fetch('https://www.googleapis.com/youtube/v3/commentThreads?part=snippet', {
      method:'POST',
      headers:{ 'Authorization':'Bearer '+googleAccessToken, 'Content-Type':'application/json' },
      body: JSON.stringify({ snippet:{ videoId, topLevelComment:{ snippet:{ textOriginal:text } } } })
    });
    return res.ok;
  }catch(e){ console.warn('Real comment failed:', e); return false; }
}

