    showView('homeView'); setBottomNavActive('home');
    document.querySelector('.cat-pill[data-cat="For You"]').classList.add('active');
    loadHome();
  } else if(hash.startsWith('#/watch/')){
    showView('watchView');
    loadWatch(hash.replace('#/watch/',''));
  } else if(hash.startsWith('#/category/')){
    showView('categoryView');
    loadCategory(hash.replace('#/category/',''));
  } else if(hash === '#/live'){
    showView('liveView');
    loadLive();
