    <div class="v-title" id="vTitle">Loading…</div>
    <div class="v-meta-row">
      <div class="chan-block"><img class="chan-avatar" id="chanAvatar" src="" alt="" style="cursor:pointer;" onclick="if(currentChannelId) location.hash='#/channel/'+currentChannelId;"><div><div class="chan-name" id="vChannel" style="cursor:pointer;" onclick="if(currentChannelId) location.hash='#/channel/'+currentChannelId;"></div><div class="chan-subs" id="vSubs">—</div></div>
