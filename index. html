function parseDurationSeconds(iso){
  if(!iso) return null;
  const m = iso.match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
  if(!m) return null;
  const h = parseInt(m[1]||0), min = parseInt(m[2]||0), s = parseInt(m[3]||0);
  return h*3600 + min*60 + s;
}
function isShortVideo(v){
  if(!v.contentDetails || !v.contentDetails.duration) return false;
  const secs = parseDurationSeconds(v.contentDetails.duration);
  // YouTube Shorts can be up to 3 minutes (180s) as of their current policy.
  return secs !== null && secs > 0 && secs <= 180;
}
// Keeps titles short and clean everywhere — long titles wrapping to 2+ lines
// looked messy, so we truncate hard with an ellipsis instead.
function truncateText(str, max=16){
  if(!str) return '';
  return str.length > max ? str.slice(0, max).trim() + '…' : str;
}

