@keyframes splashTextIn{0%{opacity:0;letter-spacing:.4em;}100%{opacity:1;letter-spacing:.14em;}}
@keyframes splashShake{0%,100%{transform:translate(0,0);}20%{transform:translate(-3px,2px);}40%{transform:translate(3px,-2px);}60%{transform:translate(-2px,-2px);}80%{transform:translate(2px,2px);}}
