<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>G.G. MasterZ's Tube</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700;800;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#08080A; --panel:#141417; --panel-2:#1C1C20;
    --bone:#F4F2ED; --bone-dim:#9C9A96;
    --ember:#FF4419; --ember-2:#FF7A3D; --ember-dim:#3D1207;
    --teal:#1FE0B0; --hairline:#232327;
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html{scroll-behavior:smooth;}
  body{background:var(--ink);color:var(--bone);font-family:'Archivo',sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden;}
  ::selection{background:var(--ember);color:var(--ink);}
  a{color:inherit;text-decoration:none;-webkit-tap-highlight-color:transparent;}
  a:focus,button:focus,input:focus{outline:none;}
  a:focus-visible,button:focus-visible{outline:2px solid var(--ember);outline-offset:2px;border-radius:4px;}
  img{display:block;max-width:100%;}
  button{font-family:inherit;border:none;background:none;color:inherit;cursor:pointer;}
  .tabular{font-variant-numeric:tabular-nums;font-family:'Space Mono',monospace;}

  @keyframes fadeUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(255,68,25,.55);}70%{box-shadow:0 0 0 10px rgba(255,68,25,0);}100%{box-shadow:0 0 0 0 rgba(255,68,25,0);}}
  @keyframes shimmer{0%{background-position:200% 0;}100%{background-position:-200% 0;}}
  @keyframes ticker{from{transform:translateX(0);}to{transform:translateX(-50%);}}
  @keyframes spin{to{transform:rotate(360deg);}}
  @keyframes mascotBlink{0%,88%,100%{transform:scaleY(1);}92%{transform:scaleY(0.1);}}
  .mascot-eye{animation:mascotBlink 4.5s ease-in-out infinite;transform-origin:center;}
  @keyframes mascotBob{0%,100%{transform:translateY(0);}50%{transform:translateY(-3px);}}

  /* ===== HEADER ===== */
  header{position:sticky;top:0;z-index:100;background:rgba(8,8,10,0.85);backdrop-filter:blur(14px);border-bottom:1px solid var(--hairline);}
  .nav-wrap{max-width:1440px;margin:0 auto;display:flex;align-items:center;gap:28px;padding:14px 24px;}
  .logo{font-family:'Archivo Black',sans-serif;font-size:20px;letter-spacing:-0.02em;display:flex;align-items:center;gap:7px;white-space:nowrap;cursor:pointer;}
  .logo .dot{color:var(--ember);}
  .nav-search{flex:1;max-width:540px;display:flex;align-items:center;background:var(--panel);border:1px solid var(--hairline);border-radius:100px;padding:0 6px 0 16px;transition:border-color .2s, box-shadow .2s;}
  .nav-search:focus-within{border-color:var(--ember);box-shadow:0 0 0 3px rgba(255,68,25,0.12);}
  .nav-search input{background:none;border:none;outline:none;color:var(--bone);font-size:14px;padding:10px 8px;width:100%;font-family:'Archivo',sans-serif;}
  .nav-search input::placeholder{color:var(--bone-dim);}
  .nav-search svg{flex-shrink:0;opacity:.55;}
  .nav-search .go-btn{width:32px;height:32px;border-radius:50%;background:var(--panel-2);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background .15s;}
  .nav-search .go-btn:hover{background:var(--ember);}
  .nav-right{display:flex;align-items:center;gap:20px;margin-left:auto;}
  .nav-link{font-size:13px;font-weight:700;color:var(--bone-dim);letter-spacing:.02em;position:relative;padding:4px 0;transition:color .15s;}
  .nav-link::after{content:'';position:absolute;bottom:-2px;left:0;width:0;height:2px;background:var(--ember);transition:width .2s ease;}
  .nav-link:hover{color:var(--bone);}
  .nav-link:hover::after{width:100%;}
  .btn-signin{background:var(--bone);color:var(--ink);font-weight:800;font-size:13px;padding:10px 20px;border-radius:100px;letter-spacing:.01em;cursor:pointer;transition:transform .15s ease, background .15s ease;}
  .btn-signin:hover{background:var(--ember);color:var(--bone);transform:translateY(-1px);}
  .side-menu-item{display:block;padding:11px 20px;font-size:14px;font-weight:600;color:var(--bone-dim);transition:background .15s,color .15s;}
  .side-menu-item:hover{background:var(--panel);color:var(--bone);}
  .search-hist-item{display:flex;align-items:center;gap:10px;padding:11px 14px;font-size:13.5px;color:var(--bone);cursor:pointer;}
  .search-hist-item:hover{background:var(--panel-2);}
  .btn-signin:active{transform:translateY(0) scale(.97);}

  .ticker-strip{background:linear-gradient(90deg, var(--ember-dim), transparent 40%, transparent 60%, var(--ember-dim));background-color:#0D0605;border-bottom:1px solid var(--hairline);overflow:hidden;white-space:nowrap;padding:7px 0;}
  .ticker-track{display:inline-block;animation:ticker 28s linear infinite;font-family:'Space Mono',monospace;font-size:11.5px;font-weight:700;letter-spacing:.03em;color:var(--ember-2);}
  .ticker-track span{margin:0 28px;}

  .cat-strip{display:flex;gap:10px;overflow-x:auto;padding:14px 24px;max-width:1440px;margin:0 auto;scrollbar-width:none;}
  .cat-strip::-webkit-scrollbar{display:none;}
  .cat-pill{flex-shrink:0;font-size:13px;font-weight:700;padding:8px 16px;border-radius:100px;border:1px solid var(--hairline);color:var(--bone-dim);transition:all .18s ease;cursor:pointer;display:flex;align-items:center;gap:6px;}
  .cat-pill.active{background:var(--bone);color:var(--ink);border-color:var(--bone);}
  .cat-pill:hover:not(.active){border-color:var(--bone-dim);color:var(--bone);transform:translateY(-1px);}

  main{max-width:1440px;margin:0 auto;padding:0 24px 90px;}

  .api-banner{background:linear-gradient(135deg, var(--panel), var(--panel-2));border:1px solid var(--ember-dim);border-radius:14px;padding:20px 22px;margin-top:22px;font-size:13.5px;line-height:1.8;color:var(--bone-dim);}
  .api-banner strong{color:var(--bone);}
  .api-banner code{background:var(--panel-2);padding:3px 8px;border-radius:5px;font-family:'Space Mono',monospace;font-size:12.5px;color:var(--teal);}

  /* ===== HERO ===== */
  .hero{display:grid;grid-template-columns:1.6fr 1fr;gap:20px;margin-top:22px;animation:fadeUp .5s ease;}
  .hero-main{position:relative;border-radius:16px;overflow:hidden;width:100%;height:0;padding-top:56.25%;background:linear-gradient(135deg,#1C1C20,#08080A);border:1px solid var(--hairline);cursor:pointer;display:block;}
  .hero-main .art{position:absolute;top:0;right:0;bottom:0;left:0;background-size:cover;background-position:center;transition:transform .6s cubic-bezier(.2,.8,.2,1);}
  .hero-main:hover .art{transform:scale(1.045);}
  .hero-main::before{content:'';position:absolute;top:0;right:0;bottom:0;left:0;background:linear-gradient(0deg, rgba(8,8,10,.15), transparent 45%);pointer-events:none;z-index:1;}
  .play-glow{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(.85);width:70px;height:70px;border-radius:50%;background:rgba(8,8,10,.55);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .25s, transform .25s;z-index:2;}
  .hero-main:hover .play-glow{opacity:1;transform:translate(-50%,-50%) scale(1);}
  .hype-badge{position:absolute;top:16px;left:16px;display:flex;align-items:center;gap:7px;background:rgba(8,8,10,0.7);backdrop-filter:blur(8px);border:1px solid rgba(255,68,25,0.5);padding:7px 14px 7px 11px;border-radius:100px;font-size:12px;font-weight:800;letter-spacing:.02em;z-index:3;}
  .flame{width:8px;height:8px;border-radius:50%;background:var(--ember);animation:pulse 1.8s infinite;flex-shrink:0;}
  .hero-info{position:absolute;bottom:0;left:0;right:0;padding:30px 26px 24px;background:linear-gradient(0deg, rgba(8,8,10,0.95) 15%, transparent);z-index:2;}
  .eyebrow{font-size:11px;font-weight:800;letter-spacing:.14em;color:var(--ember-2);text-transform:uppercase;margin-bottom:9px;}
  .hero-title{font-family:'Archivo Black',sans-serif;font-size:clamp(21px,3.2vw,32px);line-height:1.12;letter-spacing:-0.015em;max-width:92%;margin-bottom:11px;min-height:1.2em;}
  .hero-meta{display:flex;align-items:center;gap:10px;font-size:13.5px;color:#D4D2CC;}
  .chan-dot{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--ember),#8B1A00);background-size:cover;background-position:center;flex-shrink:0;border:2px solid rgba(255,255,255,.1);}

  .side-list{display:flex;flex-direction:column;gap:12px;}
  .side-card{display:flex;gap:12px;background:var(--panel);border:1px solid var(--hairline);border-radius:12px;padding:10px;cursor:pointer;transition:border-color .2s, transform .2s, background .2s;}
  .side-card:hover{border-color:#3A3A40;transform:translateX(3px);background:var(--panel-2);}
  .side-thumb{width:126px;height:0;padding-top:70.875px;border-radius:8px;flex-shrink:0;background:var(--panel-2);position:relative;overflow:hidden;}
  .side-thumb img{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;object-fit:cover;transition:transform .35s;}
  .side-card:hover .side-thumb img{transform:scale(1.08);}
  .side-rank{position:absolute;bottom:5px;left:5px;font-family:'Space Mono',monospace;font-size:10px;font-weight:700;background:rgba(0,0,0,.65);padding:2px 6px;border-radius:4px;}
  .side-body{flex:1;min-width:0;padding:2px 0;display:flex;flex-direction:column;justify-content:center;}
  .side-title{font-size:13.5px;font-weight:700;line-height:1.32;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:6px;}
  .side-sub{font-size:11.5px;color:var(--bone-dim);}

  /* ===== SECTIONS ===== */
  .section{margin-top:48px;}
  .section-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:18px;}
  .section-title{font-family:'Archivo Black',sans-serif;font-size:21px;letter-spacing:-0.015em;display:flex;align-items:center;gap:10px;}
  .section-title .tag{font-family:'Space Mono',monospace;font-size:10.5px;font-weight:700;color:var(--ember-2);border:1px solid var(--ember-dim);padding:3px 9px;border-radius:6px;background:rgba(255,68,25,.06);}
  .see-all{font-size:12.5px;font-weight:700;color:var(--bone-dim);display:flex;align-items:center;gap:4px;transition:gap .15s, color .15s;}
  .see-all:hover{color:var(--bone);gap:7px;}

  .row{display:grid;grid-auto-flow:column;grid-auto-columns:270px;gap:18px;overflow-x:auto;padding-bottom:10px;scrollbar-width:none;}
  .row::-webkit-scrollbar{display:none;}
  .card{cursor:pointer;display:block;animation:fadeUp .4s ease backwards;transition:transform .12s ease;}
  .card:active{transform:scale(.965);}
  .side-card:active{transform:scale(.97);}
  .short-card{cursor:pointer;display:block;transition:transform .12s ease;}
  .short-card:active{transform:scale(.955);}
  .cat-pill:active{transform:scale(.94);}
  .btn-signin:active{transform:scale(.94);}
  .btn-sub:active{transform:scale(.95);}
  .action-btn:active{transform:scale(.94);}
  .hero-main{transition:transform .15s ease;}
  .hero-main:active{transform:scale(.988);}
  .thumb{position:relative;width:100%;height:0;padding-top:56.25%;border-radius:12px;overflow:hidden;background:var(--panel);border:1px solid var(--hairline);margin-bottom:11px;}
  .thumb img{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;object-fit:cover;transition:transform .4s cubic-bezier(.2,.8,.2,1);}
  .card:hover .thumb img{transform:scale(1.07);}
  .thumb .dur{position:absolute;bottom:7px;right:7px;background:rgba(0,0,0,.78);font-family:'Space Mono',monospace;font-size:10.5px;font-weight:700;padding:2px 6px;border-radius:5px;}
  .card-title{font-size:14px;font-weight:700;line-height:1.36;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:7px;transition:color .15s;}
  .card:hover .card-title{color:var(--ember-2);}
  .card-chan{display:flex;align-items:center;gap:7px;}
  .mini-dot{width:19px;height:19px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,var(--ember),#8B1A00);background-size:cover;background-position:center;}
  .card-sub{font-size:11.5px;color:var(--bone-dim);}

  .shorts-row{display:grid;grid-auto-flow:column;grid-auto-columns:156px;gap:13px;overflow-x:auto;padding-bottom:10px;scrollbar-width:none;}
  .shorts-row::-webkit-scrollbar{display:none;}
  .short-thumb{position:relative;width:100%;height:0;padding-top:177.78%;border-radius:14px;overflow:hidden;background:var(--panel);border:1px solid var(--hairline);margin-bottom:8px;}
  .short-thumb img{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;object-fit:cover;transition:transform .35s;}
  .short-card:hover .short-thumb img{transform:scale(1.06);}
  .short-thumb::after{content:'▸ SHORTS';position:absolute;top:8px;left:8px;font-size:9.5px;font-weight:800;letter-spacing:.04em;color:#fff;background:rgba(0,0,0,.5);padding:3px 7px;border-radius:5px;}
  .short-title{font-size:12.5px;font-weight:600;line-height:1.32;color:var(--bone-dim);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}

  .skel{background:linear-gradient(90deg,var(--panel) 25%,var(--panel-2) 50%,var(--panel) 75%);background-size:200% 100%;animation:shimmer 1.5s infinite;border-radius:12px;}

  footer{margin-top:70px;border-top:1px solid var(--hairline);padding:34px 24px;color:var(--bone-dim);font-size:12.5px;}
  .footer-wrap{max-width:1440px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}

  /* ===== WATCH VIEW ===== */
  .watch-grid{display:none;grid-template-columns:1fr 380px;gap:30px;margin-top:22px;animation:fadeUp .4s ease;}
  .back-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:var(--bone-dim);margin-bottom:16px;grid-column:1/-1;}
  .back-link:hover{color:var(--bone);}
  .player-wrap{position:relative;border-radius:14px;overflow:hidden;background:#000;width:100%;height:0;padding-top:56.25%;border:1px solid var(--hairline);}
  .player-wrap iframe{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;border:0;}
  .v-title{font-family:'Archivo Black',sans-serif;font-size:clamp(19px,2.2vw,25px);line-height:1.22;margin-top:20px;letter-spacing:-0.015em;}
  .v-meta-row{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-top:18px;padding-bottom:20px;border-bottom:1px solid var(--hairline);}
  .chan-block{display:flex;align-items:center;gap:12px;}
  .chan-avatar{width:46px;height:46px;border-radius:50%;background:var(--panel-2);flex-shrink:0;object-fit:cover;}
  .chan-name{font-weight:800;font-size:15.5px;}
  .chan-subs{font-size:12px;color:var(--bone-dim);margin-top:2px;}
  .btn-sub{background:var(--bone);color:var(--ink);font-weight:800;font-size:13px;padding:11px 22px;border-radius:100px;margin-left:14px;transition:all .15s;}
  .btn-sub:hover{background:#fff;transform:translateY(-1px);}
  .btn-sub.subbed{background:var(--panel-2);color:var(--bone-dim);border:1px solid var(--hairline);}
  .action-group{display:flex;align-items:center;gap:10px;}
  .action-btn{display:flex;align-items:center;gap:7px;background:var(--panel);border:1px solid var(--hairline);padding:10px 16px;border-radius:100px;font-size:13px;font-weight:700;transition:all .15s;}
  .action-btn:hover{border-color:var(--bone-dim);transform:translateY(-1px);}
  .action-btn.liked{color:var(--ember-2);border-color:var(--ember-dim);}
  .desc-box{background:var(--panel);border:1px solid var(--hairline);border-radius:12px;padding:16px 18px;margin-top:18px;font-size:13px;color:var(--bone-dim);line-height:1.7;white-space:pre-wrap;}
  .desc-box strong{color:var(--bone);}
  .comments-head{font-size:15.5px;font-weight:800;margin-top:28px;margin-bottom:18px;}
  .comment{display:flex;gap:12px;margin-bottom:20px;}
  .c-avatar{width:38px;height:38px;border-radius:50%;background:var(--panel-2);flex-shrink:0;object-fit:cover;}
  .comment-body{flex:1;}
  .comment-head{display:flex;align-items:center;gap:8px;margin-bottom:4px;}
  .comment-author{font-size:12.5px;font-weight:700;}
  .comment-time{font-size:11.5px;color:var(--bone-dim);}
  .comment-text{font-size:13.5px;line-height:1.55;color:#D8D6D0;}
  .comment-likes{font-size:11px;color:var(--bone-dim);margin-top:5px;}
  .sidebar-title{font-size:13px;font-weight:800;color:var(--bone-dim);text-transform:uppercase;letter-spacing:.07em;margin-bottom:16px;}
  .rel-card{display:flex;gap:11px;margin-bottom:15px;cursor:pointer;}
  .rel-thumb{width:154px;height:0;padding-top:86.6px;border-radius:9px;overflow:hidden;flex-shrink:0;background:var(--panel);position:relative;}
  .rel-thumb img{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;object-fit:cover;}
  .rel-body{flex:1;min-width:0;}
  .rel-title{font-size:13px;font-weight:700;line-height:1.36;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:5px;}
  .rel-sub{font-size:11.5px;color:var(--bone-dim);}

  .loader{display:flex;align-items:center;justify-content:center;padding:60px 0;grid-column:1/-1;}
  .spinner{width:26px;height:26px;border:3px solid var(--hairline);border-top-color:var(--ember);border-radius:50%;animation:spin .7s linear infinite;}

  @media (max-width:960px){ .watch-grid{grid-template-columns:1fr;} }
  @media (max-width:880px){
    .hero{grid-template-columns:1fr;}
    .side-list{flex-direction:row;overflow-x:auto;scrollbar-width:none;}
    .side-list::-webkit-scrollbar{display:none;}
    .side-card{min-width:290px;}
    .nav-search{display:none;}
  }

</style>
