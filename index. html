    document.getElementById('catPageTitle').textContent = 'Shorts';
    document.getElementById('catPageSub').textContent = 'Real short-form gaming videos';
    document.getElementById('catGrid').style.gridTemplateColumns = 'repeat(auto-fill,minmax(160px,1fr))';
