let shortsState = { seenIds: new Set(), loading:false, exhausted:false };

let ytApiReady = false;
let ytApiReadyCallbacks = [];
window.onYouTubeIframeAPIReady = function(){
  ytApiReady = true;
  ytApiReadyCallbacks.forEach(cb=>cb());
  ytApiReadyCallbacks = [];
};
function whenYTReady(cb){ if(ytApiReady) cb(); else ytApiReadyCallbacks.push(cb); }

function appendShortSlide(scroll, id){
  const slide = document.createElement('div');
  const playerId = 'ytp-' + id + '-' + Math.random().toString(36).slice(2,7);
  slide.dataset.videoId = id;
  slide.style.cssText = 'height:100%;width:100%;scroll-snap-align:start;position:relative;display:flex;align-items:center;justify-content:center;background:#000;';
  slide.innerHTML = `<div id="${playerId}" style="position:absolute;top:0;right:0;bottom:0;left:0;"></div>
    <div class="skel" style="position:absolute;top:0;right:0;bottom:0;left:0;z-index:1;" id="skel-${playerId}"></div>
    <div style="position:absolute;right:12px;bottom:90px;display:flex;flex-direction:column;align-items:center;gap:22px;z-index:5;">
      <button onclick="shortsLikeToggle(this,'${id}')" data-liked="${isInLocalList('liked',id)?'1':'0'}" style="display:flex;flex-direction:column;align-items:center;gap:3px;color:#fff;">
        <svg width="27" height="27" viewBox="0 0 24 24" fill="${isInLocalList('liked',id)?'var(--ember)':'none'}" stroke="${isInLocalList('liked',id)?'var(--ember)':'white'}" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        <span style="font-size:11px;font-weight:700;">Like</span></button>
      <a href="#/watch/${id}" style="display:flex;flex-direction:column;align-items:center;gap:3px;color:#fff;">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span style="font-size:11px;font-weight:700;">Open</span></a>
      <button onclick="event.stopPropagation();navigator.share?navigator.share({url:'https://www.youtube.com/watch?v=${id}'}):alert('Share: https://www.youtube.com/watch?v=${id}')" style="display:flex;flex-direction:column;align-items:center;gap:3px;color:#fff;">
        <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7M16 6l-4-4-4 4M12 2v13"/></svg>
        <span style="font-size:11px;font-weight:700;">Share</span></button>
    </div>
    <div style="position:absolute;left:14px;right:80px;bottom:26px;z-index:5;color:#fff;" id="shortsCaption-${id}">
      <div style="font-size:13px;font-weight:700;opacity:.85;">Real gaming short</div>
    </div>`;
  scroll.appendChild(slide);

  // Outer safety net — if the YouTube Player API script itself never loads
  // (network/browser issue), don't leave this short stuck loading forever.
  setTimeout(()=>{
    if(!slide.dataset.skipped && !slide._ytPlayer){ skipBrokenShort(slide, id); }
  }, 8000);

  whenYTReady(()=>{
    try{
      let becameReady = false;
      const readyTimeout = setTimeout(()=>{
        if(!becameReady) skipBrokenShort(slide, id);
      }, 6000);
      const player = new YT.Player(playerId, {
        videoId: id,
        playerVars: { autoplay:0, rel:0, playsinline:1 },
        events: {
          onReady: ()=>{
            becameReady = true;
            clearTimeout(readyTimeout);
            const s=document.getElementById(`skel-${playerId}`); if(s) s.remove();
            if(shortsObserver) shortsObserver.observe(slide);
          },
          onError: (e)=>{ clearTimeout(readyTimeout); skipBrokenShort(slide, id); }
        }
      });
      slide._ytPlayer = player;
    }catch(e){ skipBrokenShort(slide, id); }
  });

  oEmbed(id).then(d=>{
    const cap = document.getElementById(`shortsCaption-${id}`);
    if(cap) cap.innerHTML = `<div style="font-weight:800;font-size:14px;margin-bottom:4px;">@${d.author_name}</div><div style="font-size:12.5px;line-height:1.4;opacity:.9;">${d.title}</div>`;
  }).catch(()=>{});
  addToLocalList('history', id);
  shortsState.seenIds.add(id);
}

// A short whose owner disabled embedding shows YouTube's own "configuration error"
// player — instead of ever showing that to the person, we detect it via the real
// YouTube Player API and quietly remove it, backfilling with one more real short.
function skipBrokenShort(slideEl, brokenId){
  if(slideEl.dataset.skipped) return;
  slideEl.dataset.skipped = '1';
  shortsState.brokenIds = shortsState.brokenIds || new Set();
  shortsState.brokenIds.add(brokenId);
  const scroll = document.getElementById('shortsPlayerScroll');
  const wasCurrent = Math.abs(scroll.scrollTop - slideEl.offsetTop) < 10;
  slideEl.remove();
  if(wasCurrent && scroll.children.length){
    scroll.scrollTo({top: scroll.scrollTop, behavior:'auto'});
  }
  if(scroll.children.length < 3) loadMoreShorts();
}

async function loadMoreShorts(){
  if(shortsState.loading || shortsState.exhausted) return;
  shortsState.loading = true;
  const scroll = document.getElementById('shortsPlayerScroll');
  try{
    let fresh = [];
    if(hasApiKey()){
      const queries = ['gaming shorts','valorant shorts','minecraft shorts','free fire shorts','gaming funny moments'];
      const q = queries[Math.floor(Math.random()*queries.length)];
      const res = await searchGaming(q, 10);
      fresh = res.items.filter(v=>isShortVideo(v)).map(v=>v.id).filter(id=>!shortsState.seenIds.has(id));
    }
    if(!fresh.length) fresh = FALLBACK_IDS.filter(id=>!shortsState.seenIds.has(id));
    if(!fresh.length){ shortsState.exhausted = true; shortsState.loading = false; return; }
    fresh.forEach(id=>appendShortSlide(scroll, id));
  }catch(e){}
  shortsState.loading = false;
}

function setupShortsInfiniteScroll(){
  const scroll = document.getElementById('shortsPlayerScroll');
  scroll.onscroll = ()=>{
    const nearEnd = scroll.scrollTop + scroll.clientHeight > scroll.scrollHeight - scroll.clientHeight * 1.5;
    if(nearEnd) loadMoreShorts();
  };
}

async function openShortsPlayer(startId){
  document.body.style.overflow = 'hidden';
  const wrap = document.getElementById('shortsPlayerView');
  const scroll = document.getElementById('shortsPlayerScroll');
  wrap.style.display = 'block';
  scroll.innerHTML = `<div style="height:100%;display:flex;align-items:center;justify-content:center;"><div class="spinner"></div></div>`;
  shortsState = { seenIds: new Set(), loading:false, exhausted:false };

  let ids = [];
  if(hasApiKey()){
    try{
      const res = await searchGaming('gaming shorts', 15);
      ids = res.items.filter(v=>isShortVideo(v)).map(v=>v.id);
    }catch(e){}
  }
  if(!ids.length) ids = FALLBACK_IDS.slice();
  if(startId && !ids.includes(startId)) ids.unshift(startId);

  scroll.innerHTML = '';
  ids.forEach(id=>appendShortSlide(scroll, id));
  setupShortsInfiniteScroll();
  setupShortsAutoplayObserver();

  requestAnimationFrame(()=>{
    if(startId){
      const idx = ids.indexOf(startId);
      const target = scroll.children[idx];
      if(target) target.scrollIntoView();
    }
  });
}
function setupShortsAutoplayObserver(){
  const scroll = document.getElementById('shortsPlayerScroll');
  if(shortsObserver) shortsObserver.disconnect();
  shortsObserver = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      const player = entry.target._ytPlayer;
      if(!player || typeof player.playVideo !== 'function') return;
      if(entry.isIntersecting && entry.intersectionRatio > 0.6){
        player.playVideo();
        // Some embedding restrictions (e.g. Error 153) don't fire onError —
        // the player just silently never starts. Verify it actually plays.
        const slide = entry.target;
        setTimeout(()=>{
          if(slide.dataset.skipped) return;
          try{
            const state = player.getPlayerState();
            if(state === -1 || state === 5){
              const id = slide.dataset.videoId;
              skipBrokenShort(slide, id);
            }
          }catch(e){}
        }, 2500);
      }
      else player.pauseVideo();
    });
  }, {root: scroll, threshold: [0, 0.6, 1]});
  Array.from(scroll.children).forEach(slide=>shortsObserver.observe(slide));
}
let shortsObserver = null;
function shortsLikeToggle(btn, id){
