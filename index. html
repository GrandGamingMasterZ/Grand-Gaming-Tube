    <div id="localNoteList" style="margin-top:10px;"></div>
    <div class="comments-head" id="commentsCount">Comments</div>
    <div id="commentList"></div>`;

  whenYTReady(()=>{
    try{
      let becameReady = false;
      let confirmedPlaying = false;
      const readyTimeout = setTimeout(()=>{ if(!becameReady) showWatchPlayerError(videoId); }, 7000);
      const player = new YT.Player(playerId, {
        videoId,
        playerVars: { autoplay:1, rel:0 },
        events: {
          onReady: ()=>{
            becameReady = true;
            clearTimeout(readyTimeout);
            // onReady only means the player shell loaded — some embedding
            // restrictions (like Error 153) show a broken state internally
            // without ever firing onError. So we double-check that the video
            // actually starts playing a few seconds later.
            setTimeout(()=>{
              if(confirmedPlaying) return;
              try{
                const state = player.getPlayerState();
                if(state === -1 || state === 5){ showWatchPlayerError(videoId); }
              }catch(e){ showWatchPlayerError(videoId); }
            }, 3500);
          },
          onStateChange: (e)=>{ if(e.data === 1 || e.data === 3) confirmedPlaying = true; },
          onError: ()=>{ clearTimeout(readyTimeout); showWatchPlayerError(videoId); }
        }
      });
    }catch(e){ showWatchPlayerError(videoId); }
  });

  try{
    const d = await oEmbed(videoId);
    document.getElementById('vTitle').textContent = d.title;
    document.getElementById('vChannel').textContent = d.author_name;
    try{ document.title = d.title + " — G.G. MasterZ's Tube"; }catch(e){}
  }catch{ document.getElementById('vTitle').textContent = 'Could not load real title'; }

  if(hasApiKey()){
    try{
      const v = await fetchVideoDetails(videoId);
      if(v){
        if(v.status && v.status.embeddable === false){ showWatchPlayerError(videoId); }
        currentChannelId = v.snippet.channelId;
        addToLocalList('history', videoId);
        document.getElementById('vTitle').textContent = v.snippet.title;
        document.getElementById('vChannel').textContent = v.snippet.channelTitle;
        document.getElementById('vViews').textContent = formatCount(v.statistics.viewCount)+' views';
        document.getElementById('vDesc').textContent = (v.snippet.description||'').slice(0,400);
        document.getElementById('likeCount').textContent = v.statistics.likeCount ? formatCount(v.statistics.likeCount) : '—';
        document.getElementById('likeBtn').classList.toggle('liked', liked);
        const wl = document.getElementById('watchLaterBtn');
        if(wl) wl.textContent = isInLocalList('watchlater', videoId) ? '✓ Saved' : '＋ Watch later';
        const subBtn = document.getElementById('subBtn');
        subbed = isInLocalList('subs', v.snippet.channelId);
        subBtn.textContent = subbed ? 'Subscribed' : 'Subscribe';
        subBtn.classList.toggle('subbed', subbed);
        fetchChannelDetails(v.snippet.channelId).then(ch=>{
          if(!ch) return;
          document.getElementById('vSubs').textContent = ch.statistics.hiddenSubscriberCount ? 'Subscriber count hidden' : formatCount(ch.statistics.subscriberCount)+' subscribers';
          if(ch.snippet.thumbnails) document.getElementById('chanAvatar').src = ch.snippet.thumbnails.default.url;
        }).catch(()=>{ document.getElementById('vSubs').textContent = 'Subscriber count unavailable'; });
        fetchComments(videoId,15).then(comments=>{
          document.getElementById('commentsCount').textContent = comments.length + ' Comments';
          const list = document.getElementById('commentList');
          if(!comments.length){ list.innerHTML = '<div style="color:var(--bone-dim);font-size:13px;">No comments yet, or comments are disabled.</div>'; return; }
          comments.forEach(c=>{
            const s = c.snippet.topLevelComment.snippet;
            const div = document.createElement('div'); div.className='comment';
            div.innerHTML = `<img class="c-avatar" src="${s.authorProfileImageUrl}" alt=""><div class="comment-body"><div class="comment-head"><span class="comment-author">${s.authorDisplayName}</span><span class="comment-time">${new Date(s.publishedAt).toLocaleDateString()}</span></div><div class="comment-text">${s.textDisplay}</div><div class="comment-likes">👍 ${formatCount(s.likeCount)}</div></div>`;
            list.appendChild(div);
          });
        }).catch(()=>{ document.getElementById('commentList').innerHTML = '<div style="color:var(--bone-dim);font-size:13px;">Comments could not be loaded.</div>'; });
        searchGaming(v.snippet.channelTitle,8).then(res=>{
          res.items.filter(r=>r.id!==videoId).slice(0,6).forEach(r=>{
            const a=document.createElement('a'); a.href=`#/watch/${r.id}`; a.className='rel-card';
            a.innerHTML = `<div class="rel-thumb"><img src="${r.snippet.thumbnails.medium.url}" alt=""></div><div class="rel-body"><div class="rel-title">${r.snippet.title}</div><div class="rel-sub">${r.snippet.channelTitle} · ${formatCount(r.statistics.viewCount)} views</div></div>`;
            sidebar.appendChild(a);
          });
          queueOfficialRelated(videoId, sidebar);
        }).catch(()=>{ queueOfficialRelated(videoId, sidebar); });
        return;
      }
    }catch(e){}
  }

  // no key / API failed: honest fallback for stats + comments, real related list via oEmbed
  document.getElementById('vViews').textContent = 'View count needs a YouTube API key';
  document.getElementById('vSubs').textContent = 'Subscriber count needs a YouTube API key';
  document.getElementById('commentList').innerHTML = '<div style="color:var(--bone-dim);font-size:13px;">Real comments need a YouTube API key set in the code.</div>';
  FALLBACK_IDS.filter(id=>id!==videoId).forEach(id=>{
    const a=document.createElement('a'); a.href=`#/watch/${id}`; a.className='rel-card';
    a.innerHTML = `<div class="rel-thumb"><img src="https://img.youtube.com/vi/${id}/mqdefault.jpg" alt=""></div><div class="rel-body"><div class="rel-title" data-t>Loading…</div><div class="rel-sub">Real video</div></div>`;
    sidebar.appendChild(a);
    oEmbed(id).then(d=>{ a.querySelector('[data-t]').textContent = d.title; }).catch(()=>{ a.querySelector('[data-t]').textContent = 'Could not load'; });
  });
  queueOfficialRelated(videoId, sidebar);
}
// ============================================================
// Local personal data — real, stored only on this device (localStorage).
// Not fake: these are the person's actual watch/like/save actions.
// ============================================================
function getLocalList(key){ try{ return JSON.parse(localStorage.getItem('ggmz_'+key) || '[]'); }catch{ return []; } }
function setLocalList(key, arr){ try{ localStorage.setItem('ggmz_'+key, JSON.stringify(arr.slice(0,40))); }catch{} }
function addToLocalList(key, id){
  let list = getLocalList(key).filter(x=>x!==id);
  list.unshift(id);
  setLocalList(key, list);
}
function removeFromLocalList(key, id){ setLocalList(key, getLocalList(key).filter(x=>x!==id)); }
function isInLocalList(key, id){ return getLocalList(key).includes(id); }
function clearLocalList(key){ setLocalList(key, []); if(location.hash==='#/you') loadYouPage(); }

let subbed=false, liked=false, currentWatchId=null, currentChannelId=null;
function toggleSub(){
  subbed=!subbed;
  const b=document.getElementById('subBtn'); if(b){ b.textContent=subbed?'Subscribed':'Subscribe'; b.classList.toggle('subbed',subbed);}
  if(currentChannelId){
    if(subbed){ addToLocalList('subs', currentChannelId); realSubscribe(currentChannelId); }
    else{ removeFromLocalList('subs', currentChannelId); }
  }
}
function toggleLike(){
  liked=!liked;
  const b=document.getElementById('likeBtn'); if(b) b.classList.toggle('liked',liked);
  if(currentWatchId){
    if(liked){ addToLocalList('liked', currentWatchId); realLike(currentWatchId); }
    else{ removeFromLocalList('liked', currentWatchId); realLike(currentWatchId, true); }
  }
}
function toggleWatchLater(id, btn){
  if(!id) return;
  const saved = isInLocalList('watchlater', id);
  if(saved){ removeFromLocalList('watchlater', id); if(btn) btn.textContent = '＋ Watch later'; }
  else{ addToLocalList('watchlater', id); if(btn) btn.textContent = '✓ Saved'; }
}
async function shareCurrentVideo(){
  const id = currentWatchId;
  if(!id) return;
  const url = 'https://www.youtube.com/watch?v='+id;
  try{
    if(navigator.share){ await navigator.share({title:document.title, url}); return; }
  }catch(e){}
  try{
    await navigator.clipboard.writeText(url);
    const b = document.getElementById('shareBtn');
    if(b){ const old=b.textContent; b.textContent='Copied'; setTimeout(()=>{b.textContent=old;},1400); }
  }catch(e){ prompt('Copy this link:', url); }
}

