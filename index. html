  // categoryId field that videos.list actually returns per video.
  const params = {part:"snippet",q:query,type:"video",maxResults: Math.min(maxResults*3,50),order:"relevance"};
  if(pageToken) params.pageToken = pageToken;
  const s = await ytFetch("search", params);
  const ids = (s.items||[]).map(i=>i.id.videoId).filter(Boolean);
  if(!ids.length) return {items:[], nextPageToken:null};
  const d = await ytFetch("videos", {part:"snippet,statistics,contentDetails,status", id: ids.join(",")});
  const items = (d.items||[])
    .filter(v=>v.status && v.status.embeddable)
    .filter(v=>v.snippet && v.snippet.categoryId === GAMING_CATEGORY_ID)
    .slice(0,maxResults);
  return {items, nextPageToken: s.nextPageToken || null};
}
