</style>
<style id="ggm-v6-upgrade">
:root{
 --ggm-purple:#7c3aed;
 --ggm-blue:#2563eb;
 --ggm-pink:#ec4899;
 --ggm-cyan:#22d3ee;
}
.ggm-top-banner{
  background:linear-gradient(90deg,#3D1207,#6d28d9 40%,#2563eb);
  color:#fff;padding:13px 18px;border-radius:14px;
  margin-top:18px;font-weight:800;font-size:13.5px;
  display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;
  border:1px solid var(--ember-dim);
}
.ggm-ai-card{
  background:linear-gradient(135deg,#17111f,#101216);
  border:1px solid #3b2760;border-radius:16px;padding:16px 18px;margin-top:14px;
}
.ggm-ai-card h2{font-family:'Archivo Black',sans-serif;font-size:16px;margin-bottom:6px;}
.ggm-ai-card p{font-size:13px;color:var(--bone-dim);margin-bottom:10px;}
