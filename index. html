async function loadRecommendations(){
  const section = document.getElementById('recommendedSection');
  const row = document.getElementById('recommendedRow');
  const history = getLocalList('history');

  if(!history.length){ section.style.display = 'none'; return; }

  skeletonRow(row, 5, 'card');
  section.style.display = 'block';

  try{
    // Look at the last few watched videos to find a pattern (repeated channel or game word)
    const sample = history.slice(0, 8);
    const meta = await Promise.all(sample.map(async id=>{
      try{ const d = await oEmbed(id); return {id, title:d.title, channel:d.author_name}; }
      catch{ return null; }
    }));
    const valid = meta.filter(Boolean);
    if(!valid.length){ section.style.display='none'; return; }

    // Count how often each channel appears — that's the strongest real signal
    const channelCounts = {};
    valid.forEach(v=>{ channelCounts[v.channel] = (channelCounts[v.channel]||0) + 1; });
    const topChannel = Object.entries(channelCounts).sort((a,b)=>b[1]-a[1])[0][0];

    // Pull a common word from watched titles as a secondary signal (e.g. game name)
    const words = valid.flatMap(v=>v.title.toLowerCase().split(/[^a-z0-9]+/)).filter(w=>w.length>3);
    const wordCounts = {};
    words.forEach(w=>{ wordCounts[w] = (wordCounts[w]||0) + 1; });
    const topWord = Object.entries(wordCounts).sort((a,b)=>b[1]-a[1])[0];

    const query = topWord && topWord[1] > 1 ? topWord[0] : topChannel;
    document.querySelector('#recommendedSection .section-title').innerHTML = `Because you watched <span style="color:var(--ember-2);">${topChannel}</span> <span class="tag">YOUR HISTORY</span>`;

    if(hasApiKey()){
      const res = await searchGaming(query, 10);
      const filtered = res.items.filter(v=>!history.includes(v.id));
      row.innerHTML = '';
      if(!filtered.length){ section.style.display='none'; return; }
      filtered.forEach(v=>{ row.appendChild(smartCardAnchor(v)); });
    } else {
      section.style.display = 'none'; // needs real API for real recommendations, no fake fallback here
    }
  }catch(e){ section.style.display = 'none'; }
}

