let homeState = { pageToken: null, usingFallbackTopic: false, loading:false };
let homeObserver = null;
function setupHomeInfiniteScroll(){
  if(homeObserver) homeObserver.disconnect();
  let sentinel = document.getElementById('homeSentinel');
  if(!sentinel){
    sentinel = document.createElement('div');
    sentinel.id = 'homeSentinel';
    sentinel.style.cssText = 'grid-column:1/-1;height:1px;';
  }
  document.getElementById('moreRow').appendChild(sentinel);
  homeObserver = new IntersectionObserver(async (entries)=>{
    if(entries[0].isIntersecting && !homeState.loading){
      homeState.loading = true;
      await loadMoreHomeTrending();
      homeState.loading = false;
    }
  }, {rootMargin:'400px'});
  homeObserver.observe(sentinel);
}
async function loadMoreHomeTrending(){
  const moreRow = document.getElementById('moreRow');
  const sentinel = document.getElementById('homeSentinel');
  const spinner = document.createElement('div');
  spinner.style.cssText = 'grid-column:1/-1;display:flex;justify-content:center;padding:16px 0;';
  spinner.innerHTML = '<div class="spinner"></div>';
  moreRow.insertBefore(spinner, sentinel);

  try{
    if(homeState.pageToken !== undefined && homeState.pageToken !== null && !homeState.usingFallbackTopic){
      const res = await fetchTrendingGaming(12, homeState.pageToken);
      spinner.remove();
      if(res.items.length){
        const shorts = res.items.filter(v=>isShortVideo(v));
        const longs = res.items.filter(v=>!isShortVideo(v));
        longs.forEach(v=>{ const a=document.createElement('a'); a.className='card'; a.href=`#/watch/${v.id}`; a.innerHTML=cardHTML(v); moreRow.insertBefore(a, sentinel); });
        insertShortsShelf(moreRow, shorts, sentinel);
        populateAvatars(moreRow);
      }
      homeState.pageToken = res.nextPageToken;
      if(!homeState.pageToken){
        const label = document.createElement('div');
        label.style.cssText = 'grid-column:1/-1;font-size:12px;font-weight:700;color:var(--ember-2);text-transform:uppercase;letter-spacing:.06em;padding-top:10px;text-align:center;';
        label.textContent = "That's all the trending videos right now — showing more gaming videos below";
        moreRow.insertBefore(label, sentinel);
        homeState.usingFallbackTopic = true;
      }
    } else {
      const res = await searchGaming(homeState.varietyQuery || (homeState.varietyQuery = pickVarietyQuery()), 12, homeState.pageToken);
      spinner.remove();
      const shorts = res.items.filter(v=>isShortVideo(v));
      const longs = res.items.filter(v=>!isShortVideo(v));
      longs.forEach(v=>{ const a=document.createElement('a'); a.className='card'; a.href=`#/watch/${v.id}`; a.innerHTML=cardHTML(v); moreRow.insertBefore(a, sentinel); });
      insertShortsShelf(moreRow, shorts, sentinel);
      populateAvatars(moreRow);
      homeState.pageToken = res.nextPageToken;
      if(!homeState.pageToken && homeObserver){ homeObserver.disconnect(); }
    }
  }catch(e){ spinner.remove(); if(homeObserver) homeObserver.disconnect(); }
}

let watchErrorHandled = new Set();
async function showWatchPlayerError(videoId){
  if(watchErrorHandled.has(videoId)) return; // avoid loops if the replacement also fails once
  watchErrorHandled.add(videoId);
  const wrap = document.querySelector('.player-wrap');
  if(wrap) wrap.dataset.errorShown = '1';
  if(currentWatchId !== videoId) return; // user already navigated away — do nothing

  showToast("That video can't play here — loading a similar one instead");
  let replacementId = null;
  try{
    const hint = document.getElementById('vChannel')?.textContent
      || document.getElementById('vTitle')?.textContent
      || 'gaming highlights';
    if(hasApiKey()){
      const res = await searchGaming(hint, 8);
      const candidate = (res.items||[]).find(v => v.id !== videoId && !watchErrorHandled.has(v.id));
      if(candidate) replacementId = candidate.id;
    }
  }catch(e){ /* fall through to fallback list below */ }
  if(!replacementId){
    replacementId = FALLBACK_IDS.find(id => id !== videoId && !watchErrorHandled.has(id)) || FALLBACK_IDS[0];
  }
  location.hash = '#/watch/' + replacementId;
}

async function loadWatch(videoId){
  const left = document.getElementById('watchLeft');
