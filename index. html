      const grid = document.getElementById('catGrid');
      skeletonRow(grid, 8, 'short-card');
      if(hasApiKey()){
        try{
          const searchRes = await searchGaming(pickShortsQuery(), 20);
          const shorts = searchRes.items.filter(v=>isShortVideo(v));
          if(shorts.length){ grid.innerHTML=''; shorts.forEach(v=>{ const a=document.createElement('a'); a.className='short-card'; a.href=`#/shortsplay/${v.id}`; a.innerHTML=`<div class="short-thumb"><img src="${v.snippet.thumbnails.medium.url}" alt=""></div><div class="short-title">${v.snippet.title}</div>`; grid.appendChild(a); }); return; }
        }catch(e){}
      }
      grid.innerHTML = '';
      const results = await Promise.all(FALLBACK_IDS.map(async id=>{ try{ const d=await oEmbed(id); return {id,title:d.title}; }catch{ return {id,title:'Could not load'}; }}));
      results.forEach(r=>{ const a=document.createElement('a'); a.className='short-card'; a.href=`#/shortsplay/${r.id}`; a.innerHTML=`<div class="short-thumb"><img src="https://img.youtube.com/vi/${r.id}/mqdefault.jpg" alt=""></div><div class="short-title">${r.title}</div>`; grid.appendChild(a); });
    })();
  } else if(hash.startsWith('#/shortsplay')){
    setBottomNavActive('shorts');
    const startId = hash.replace('#/shortsplay/','').replace('#/shortsplay','');
    openShortsPlayer(startId || null);
  } else if(hash === '#/you'){
    showView('youView'); setBottomNavActive('you');
    loadYouPage();
  } else if(hash === '#/subscriptions'){
    showView('subscriptionsView'); setBottomNavActive('subs');
  } else if(hash.startsWith('#/channel/')){
    showView('channelView');
    loadChannel(hash.replace('#/channel/',''));
  } else if(hash === '#/notifications'){
    showView('notificationsView');
    loadNotifications();
  } else if(hash === '#/signin'){
    showView('signinView');
  } else if(hash === '#/settings'){
    showView('settingsView');
    refreshSettingsUI();
  } else {
    showView('homeView'); setBottomNavActive('home'); loadHome();
  }
}
