    if(tab === 'shorts') items = items.filter(v=>isShortVideo(v));
    grid.innerHTML = '';
    if(!items.length){ grid.innerHTML = `<p style="color:var(--bone-dim);font-size:13px;">No ${tab} found for this channel.</p>`; return; }
    items.forEach(v=>{
      const a = document.createElement('a');
      if(tab === 'shorts'){ a.className = 'short-card'; a.href = `#/shortsplay/${v.id}`; a.innerHTML = shortCardHTML(v); }
      else{ a.className = 'card'; a.href = `#/watch/${v.id}`; a.innerHTML = cardHTML(v); }
