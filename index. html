    <div class="card-chan"><div class="mini-dot" ${chanId?`data-chan="${chanId}"`:''}></div><span class="card-sub" ${chanClick} style="${chanId?'cursor:pointer;':''}">${truncateText(channel,18)}${views?" · "+views:""}</span></div>`;
}

// ============================================================
// Real channel avatars — batch-fetched (up to 50 per API call) and cached,
// then popped into any .mini-dot[data-chan] found inside a container. Cards
// render instantly with a placeholder gradient dot; real avatars fill in a
// moment later without blocking the page.
// ============================================================
const channelAvatarCache = {};
async function fetchChannelAvatars(ids){
  const unique = [...new Set(ids)].filter(Boolean);
  const missing = unique.filter(id => !channelAvatarCache[id]);
  if(missing.length && hasApiKey()){
    for(let i=0; i<missing.length; i+=50){
      const batch = missing.slice(i, i+50);
      try{
        const data = await ytFetch("channels", {part:"snippet", id: batch.join(",")});
        (data.items||[]).forEach(ch=>{ channelAvatarCache[ch.id] = ch.snippet.thumbnails.default.url; });
      }catch(e){ /* leave cache empty for these — fallback dot stays */ }
    }
  }
  return channelAvatarCache;
}
async function populateAvatars(containerEl){
  if(!containerEl) return;
  const dots = Array.from(containerEl.querySelectorAll('.mini-dot[data-chan], .chan-dot[data-chan]'));
  const ids = dots.map(d => d.dataset.chan);
  if(!ids.length) return;
  await fetchChannelAvatars(ids);
  dots.forEach(d=>{
    const url = channelAvatarCache[d.dataset.chan];
    if(url) d.style.backgroundImage = `url('${url}')`;
  });
}
function skeletonRow(container, count, cls){
