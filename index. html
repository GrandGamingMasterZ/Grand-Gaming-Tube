<style>
@keyframes splashFlashBurst{0%{opacity:0;}8%{opacity:.9;}22%{opacity:0;}100%{opacity:0;}}
@keyframes splashRaysSpin{0%{transform:rotate(0deg) scale(.4);opacity:0;}30%{opacity:.9;}100%{transform:rotate(140deg) scale(1.3);opacity:0;}}
@keyframes splashGlowPulse{0%{transform:scale(1);opacity:0;}25%{opacity:1;transform:scale(1.4);}45%{opacity:1;}100%{transform:scale(11);opacity:0;}}
@keyframes splashMascotIn{0%{opacity:0;transform:scale(.3) rotate(-8deg);filter:brightness(2.5);}45%{opacity:1;}60%{transform:scale(1.15) rotate(2deg);filter:brightness(1.3);}78%{transform:scale(0.94) rotate(-1deg);}100%{opacity:1;transform:scale(1) rotate(0deg);filter:brightness(1);}}
