let currentChannelPageId = null;
let channelTabsWired = false;
function setupChannelTabsOnce(){
  if(channelTabsWired) return;
  channelTabsWired = true;
  // Delegated listener — attached exactly once, ever. Never duplicates,
  // regardless of how many different channels the person visits.
  document.querySelector('#channelView').addEventListener('click', (e)=>{
    const t = e.target.closest('.chan-tab');
    if(!t || !currentChannelPageId) return;
    document.querySelectorAll('.chan-tab').forEach(x=>{x.style.color='var(--bone-dim)';x.style.borderBottomColor='transparent';});
    t.style.color='var(--bone)'; t.style.borderBottomColor='var(--ember)';
    loadChannelVideos(currentChannelPageId, t.dataset.tab);
  });
}
async function loadChannelVideos(channelId, tab){
  const grid = document.getElementById('channelGrid');
  grid.style.gridTemplateColumns = tab==='shorts' ? 'repeat(auto-fill,minmax(160px,1fr))' : 'repeat(auto-fill,minmax(240px,1fr))';
  skeletonRow(grid, 8, tab==='shorts' ? 'short-card' : 'card');
