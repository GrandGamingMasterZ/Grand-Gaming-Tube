let nextTimer=null;
function setupNextUp(videoId){
  const wrap=document.querySelector('#watchView .player-wrap');
  if(!wrap) return;
  let bar=document.getElementById('nextBar');
  if(!bar){
    bar=document.createElement('div');
    bar.id='nextBar';
    bar.className='next-bar';
    wrap.appendChild(bar);
  }
  const nxt=window._nextOfficial;
  if(!nxt){ bar.classList.remove('show'); return; }
  bar.innerHTML = `<div class="rowish">
      <div><div style="font-size:11px;color:var(--ember-2);font-weight:800;">UP NEXT · HOUSE CHANNEL</div>
      <div style="font-size:13px;font-weight:700;margin-top:3px;">${nxt.snippet.title}</div></div>
      <div style="display:flex;gap:8px;">
        <button class="action-btn" onclick="cancelNextUp()">Cancel</button>
        <button class="btn-sub" style="margin:0;" onclick="playNextOfficial()">Play now</button>
      </div>
    </div><div class="progress-line"><span id="nextProg"></span></div>`;
  // Offer next after 90s of being on the page — once, and only if the user stays.
  clearTimeout(nextTimer);
  nextTimer=setTimeout(()=>{
    bar.classList.add('show');
    const prog=document.getElementById('nextProg');
    let n=0;
    const iv=setInterval(()=>{
      n+=2;
      if(prog) prog.style.width=n+'%';
      if(n>=100){ clearInterval(iv); playNextOfficial(); }
    }, 160);
    bar.dataset.iv=String(iv);
  }, 90000);
}
function cancelNextUp(){
  const bar=document.getElementById('nextBar');
  if(bar){ bar.classList.remove('show'); if(bar.dataset.iv) clearInterval(Number(bar.dataset.iv)); }
  clearTimeout(nextTimer);
}
function playNextOfficial(){
  const nxt=window._nextOfficial;
  cancelNextUp();
  if(nxt) location.hash='#/watch/'+nxt.id;
